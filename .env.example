GARMIN_EMAIL=tu_correo@ejemplo.com
GARMIN_PASSWORD=tu_contraseña

# Clave compartida que debe enviar el cliente MCP remoto (cabecera Authorization: Bearer <valor>)
MCP_AUTH_TOKEN=genera_un_valor_aleatorio

# Clave compartida que debe enviar connector_web.py al llamar a /internal/login
# (distinta de MCP_AUTH_TOKEN)
INTERNAL_LOGIN_TOKEN=genera_otro_valor_aleatorio

# Solo necesarias para connector_web.py
MCP_PUBLIC_URL=http://localhost:8000
