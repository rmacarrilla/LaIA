# Cadena de conexión a Postgres (registro de usuarios y estado OAuth)
DATABASE_URL=postgres://usuario:contraseña@host:5432/basededatos

# Clave para cifrar la sesión de Garmin de cada usuario y hashear su email en
# Postgres. Genera un valor aleatorio largo (p.ej. `python3 -c "import secrets;
# print(secrets.token_urlsafe(32))"`) y no lo cambies una vez haya usuarios
# registrados — perderías la capacidad de descifrar sus sesiones guardadas.
SESSION_ENCRYPTION_KEY=genera_un_valor_aleatorio
